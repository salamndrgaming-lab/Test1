# All keys are OPTIONAL. The app runs fully on free keyless sources + bundled seed data.
# Adding keys simply enriches live data.

# The Odds API (https://the-odds-api.com) — optional, free tier ~500 credits/mo.
# Without it, sports odds come from ESPN keyless endpoints, then seed data.
ODDS_API_KEY=

# TMDB (https://www.themoviedb.org/settings/api) — optional free key for entertainment.
# Without it, entertainment uses RSS + bundled seed catalog.
TMDB_API_KEY=
