# All keys are OPTIONAL for the free/live app. They enable monetization +
# commercial-grade infra. See LAUNCH.md for setup steps.

# --- Data (optional enrichment; app runs on free sources without these) ---
ODDS_API_KEY=
TMDB_API_KEY=

# --- Email / newsletter (Resend) ---
# Without these, /api/subscribe validates + acknowledges but does not persist.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# --- Payments (Stripe) — required for live Pro billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth + DB (Supabase) — required for accounts + server-verified Pro ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Caching (Upstash Redis) — optional; cuts API calls + rate limits ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Ads (Google AdSense) — free tier shows ads to non-Pro users after consent ---
# Publisher id, e.g. "ca-pub-1234567890123456". /ads.txt is generated from this.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional manual ad-unit slot id for the in-feed unit; blank = auto/house promo.
NEXT_PUBLIC_ADSENSE_SLOT_FEED=

# --- Analytics / monitoring (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
