# All keys are OPTIONAL for the free/live app. They enable monetization +
# commercial-grade infra. See LAUNCH.md for setup steps.

# --- Data ---
# ODDS_API_KEY is the single highest-impact key in this file for the SGP tool.
# With one price source, edge is pinned at minus half the bookmaker's hold BY
# ARITHMETIC — positive expected value is impossible, not merely rare, because
# "consensus fair value" is that one book's own de-vigged price. A multi-book
# feed is the only thing that can change that number.
#   Free tier: the-odds-api.com — 500 credits/month, no card.
#   A credit is markets x regions per request, so one call for h2h+spreads+
#   totals costs 3. We make ONE call per league (not per game), cache each
#   slate for 5 minutes, and stop at 25 remaining credits, which keeps a
#   normal day's traffic inside the allowance.
ODDS_API_KEY=

# GROQ_API_KEY powers the "Ask the model" assistant on the SGP tab. Without
# it the assistant still answers, from a deterministic engine that reads the
# same slate data — the replies are just stiffer. Groq has a free tier and an
# OpenAI-compatible endpoint, so another provider is a base-URL change.
#   Free key: console.groq.com
# GROQ_MODEL is optional. Groq retires model ids periodically; if the
# assistant reports "model-unavailable", set this to a current one from
# console.groq.com/docs/models. Default: llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=

TMDB_API_KEY=
TMDB_API_KEY=

# --- Email / newsletter (Resend) ---
# Without these, /api/subscribe validates + acknowledges but does not persist.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# --- Payments (Stripe) — required for live Pro billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth + DB (Supabase) — required for accounts + server-verified Pro ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Caching (Upstash Redis) — optional; cuts API calls + rate limits ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Ads (Google AdSense) — free tier shows ads to non-Pro users after consent ---
# Publisher id, e.g. "ca-pub-1234567890123456". /ads.txt is generated from this.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional manual ad-unit slot id for the in-feed unit; blank = auto/house promo.
NEXT_PUBLIC_ADSENSE_SLOT_FEED=

# --- Analytics / monitoring (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
